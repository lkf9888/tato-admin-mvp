DATABASE_URL="file:./dev.db"
ADMIN_EMAIL="admin@local.test"
ADMIN_PASSWORD="admin123"
SESSION_SECRET="replace-with-a-long-random-string"
# Timezone used to interpret wall-clock times in imported Turo CSV exports.
# Server clock. Must match the fleet's operating timezone: offline orders
# created in the admin UI are parsed as server-local time, while CSV imports
# use CSV_IMPORT_TIMEZONE. Keep these two in sync or the same wall-clock time
# lands in the database differently depending on which path created it.
TZ=America/Vancouver
# IANA timezone name (e.g. America/Vancouver, America/Los_Angeles, Asia/Shanghai).
CSV_IMPORT_TIMEZONE="America/Vancouver"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Resend HTTPS API sender. Verify tatocar.co in Resend before using a
# tatocar.co sender address.
RESEND_API_KEY=""
RESEND_FROM="TATO <no-reply@tatocar.co>"
# Optional override used only for offline staff task assignment emails.
STAFF_TASK_EMAIL_FROM="TATO Tasks <tasks@tatocar.co>"
# Optional Twilio SMS sender for staff task notifications.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
TWILIO_MESSAGING_SERVICE_SID=""
SMS_DEFAULT_COUNTRY_CODE="+1"
# WeChat Mini Program staff task portal. Leave empty until a Mini Program is registered.
WECHAT_MINIPROGRAM_APP_ID=""
WECHAT_MINIPROGRAM_APP_SECRET=""
WECHAT_TASK_TEMPLATE_ID=""
WECHAT_MINIPROGRAM_STATE="trial"
WECHAT_TASK_MESSAGE_FIELDS=""
# Optional. Defaults to ./data/uploads locally and /app/data/uploads on Railway.
TATO_UPLOAD_DIR=""
STRIPE_SECRET_KEY=""
STRIPE_LISTING_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Inbox that receives in-app feedback / bug reports submitted via the
# floating "Contact" button. Leave empty to disable the feature.
FEEDBACK_RECIPIENT_EMAIL=""
# Optional fallback Turo CSV auto-sync source. The app first uses the workspace
# setting saved on the CSV Import page; set exactly one env source only if you
# need a deployment-level fallback.
# The URL can be a private/signed CSV URL; the path can point at a file on the
# persistent volume.
TURO_SYNC_CSV_URL=""
# Optional year used when TURO_SYNC_CSV_URL contains "{year}" or points at
# https://turo.com/api/earnings/download.
TURO_SYNC_CSV_YEAR=""
TURO_SYNC_CSV_PATH=""
# Optional Authorization header for TURO_SYNC_CSV_URL, e.g. "Bearer token".
TURO_SYNC_CSV_AUTH_HEADER=""
# Optional JSON object of extra request headers for TURO_SYNC_CSV_URL.
TURO_SYNC_CSV_HEADERS=""
# Optional JSON mapping. Accepts either {"Reservation ID":"externalOrderId"}
# or {"externalOrderId":"Reservation ID"}.
TURO_SYNC_CSV_MAPPING=""
TURO_SYNC_CREATE_MISSING_VEHICLES="true"
# Keep false for scheduled syncs unless the CSV source is a complete source of truth.
TURO_SYNC_ARCHIVE_MISSING="false"
TURO_SYNC_WORKSPACE_SLUG="default"
TURO_SYNC_ACTOR="Turo auto sync"
# Optional secret for external cron callers hitting POST /api/turo-sync.
TURO_SYNC_SECRET=""

# --- AI assistant (Kimi / Moonshot) ---
# Get a key at platform.moonshot.ai. The account needs a small top-up
# before the key works. Leave empty to disable the assistant entirely —
# the page then explains it is not configured instead of erroring.
KIMI_API_KEY=
# Optional overrides. Defaults: kimi-k2.6 for chat, kimi-k2.5 for email
# extraction. NOTE: the kimi-k2 series was discontinued 2026-05-25;
# current models are kimi-k3, kimi-k2.6, kimi-k2.5.
KIMI_CHAT_MODEL=
KIMI_EXTRACTION_MODEL=

# --- Turo inbox via Gmail IMAP ---
# Turo has no API and no webhooks, but it emails every guest message,
# booking, cancellation, and support notice. Reading that mailbox is the
# only near-real-time channel available.
#
# GMAIL_IMAP_PASSWORD must be a Gmail *App Password* (16 characters),
# not the account password. Requires 2-Step Verification on the account:
# myaccount.google.com > Security > 2-Step Verification > App passwords.
# Revoke it there if it ever leaks — it works independently of the
# account password.
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
# Comma-separated sending domains to ingest. This is the blast-radius
# control: the credential can read the whole mailbox, so keep this tight.
GMAIL_ALLOWED_SENDERS=turo.com
# Shared secret so a scheduler can POST /api/gmail-sync without a session.
GMAIL_SYNC_SECRET=
