<?xml version="1.0" encoding="utf-8"?>
<!-- The mark is drawn full-bleed on its own dark tile, so the adaptive
     icon uses it as the background and leaves the foreground empty:
     the launcher's mask crops the tile, and the geometry already sits
     inside the safe circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_maskable" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
