generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  available
  maintenance
  inactive
}

enum OwnerAccessType {
  share_link
  account_login
}

enum OrderSource {
  turo
  offline
}

enum OrderStatus {
  booked
  ongoing
  completed
  cancelled
}

enum ShareVisibility {
  standard
  privacy
}

enum WorkspaceBillingStatus {
  inactive
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum OwnerLedgerKind {
  OWNER_NET_EARNING
  MANAGER_COMMISSION
  CLEANING_FEE
  EXPENSE_REIMBURSEMENT
  MANUAL_ADJUSTMENT
  SETTLEMENT_PAYMENT
  // Rent the guest paid straight to the owner, so we never held it.
  // Recorded as an offsetting line rather than by omitting the revenue
  // line, because the owner still needs to see what the trip earned --
  // the commission is a percentage of it, and a bill you cannot check
  // the arithmetic on is a bill you argue about.
  DIRECT_TO_OWNER
}

/// Who receives the rent before anyone settles up.
///
/// Not a detail of presentation -- it decides which direction money
/// moves at the end of the month. When it lands with the company we owe
/// the owner their share, so the statement is a payout. When it lands
/// with the owner they hold money that is partly ours, so the statement
/// is an invoice for the commission. Same percentage, opposite sign.
enum OwnerSettlementDirection {
  COMPANY_COLLECTS
  OWNER_COLLECTS
}

enum OrderAttachmentKind {
  photo
  document
}

enum StaffTaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum StaffTaskPriority {
  low
  normal
  high
}

enum ContractFieldType {
  SIGNATURE
  TEXT
  DATE
  CHECKBOX
  REDACTION
}

enum ContractEnvelopeStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  COMPLETED
  VOIDED
  EXPIRED
}

enum ContractRecipientStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum ContractAuditEvent {
  CREATED
  SENT
  VIEWED
  SIGNED
  COMPLETED
  VOIDED
  PDF_GENERATED
  EMAIL_FAILED
}

// Who keeps a given category of trip income when splitting with a
// vehicle owner. OWNER means it flows through to the owner's statement
// like ordinary rental revenue; MANAGER means the fleet operator keeps
// it and the owner's statement carries an explicit deduction line for
// that amount.
enum LedgerShareTarget {
  OWNER
  MANAGER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner revenue-split policy. Turo's `Total earnings` bundles several
  // kinds of income together, and who they belong to depends on the
  // operator's arrangement with each vehicle owner:
  //
  //   reimbursementShare — gas, tolls, EV charging, cleaning. Money the
  //     guest paid back for a cost somebody fronted. Belongs to whoever
  //     actually paid it.
  //   serviceShare       — delivery, extras, airport operations fee.
  //     Payment for labour, so it belongs to whoever performed it.
  //   penaltyShare       — late / improper-return / smoking fees and
  //     fines paid to host. These compensate for harm to the vehicle,
  //     so OWNER is the usual answer.
  //
  // All three default to OWNER, which reproduces the behaviour that
  // shipped in v0.24.0 (the full `Total earnings` reaching the owner).
  // Changing a setting only affects statements the next time the
  // affected orders are re-synced.
  reimbursementShare            LedgerShareTarget              @default(OWNER)
  serviceShare                  LedgerShareTarget              @default(OWNER)
  penaltyShare                  LedgerShareTarget              @default(OWNER)
  users                         User[]
  owners                        Owner[]
  vehicles                      Vehicle[]
  orders                        Order[]
  importBatches                 ImportBatch[]
  shareLinks                    ShareLink[]
  activityLogs                  ActivityLog[]
  ownerLedgerItems              OwnerLedgerItem[]
  ownerCommissionRules          OwnerCommissionRule[]
  pendingOrders                 PendingOrder[]
  vehicleCleaningFeeRules       VehicleCleaningFeeRule[]
  ownerLedgerReceipts           OwnerLedgerReceipt[]
  orderAttachments              OrderAttachment[]
  staffMembers                  StaffMember[]
  staffTasks                    StaffTask[]
  staffTaskAttachments          StaffTaskAttachment[]
  staffTaskNotificationTemplate StaffTaskNotificationTemplate?
  directBookingDocuments        DirectBookingDocument[]
  contractTemplates             ContractTemplate[]
  contractEnvelopes             ContractEnvelope[]
  contractAuditLogs             ContractAuditLog[]
  contractTextPresets           ContractTextPreset[]
  turoSyncConfig                TuroSyncConfig?
  billing                       WorkspaceBilling?
  inboundEmails                 InboundEmail[]
  agentTokens                   AgentToken[]
  turoConversationMessages      TuroConversationMessage[]
  assistantThreads              AssistantThread[]
  assistantAlerts               AssistantAlert[]
  messageTemplates              MessageTemplate[]
  calendarNotes                 CalendarNote[]
  calendarFeeds                 CalendarFeed[]
  orderPayments                 OrderPayment[]
  inspectionSessions            InspectionSession[]
  inspectionShots               InspectionShot[]
  rentalSite                    RentalSite?
  bookingChangeRequests         BookingChangeRequest[]
  bookingPricingPolicy          BookingPricingPolicy?
  directBookingEmailTemplate    DirectBookingEmailTemplate?
}

model User {
  id              String     @id @default(cuid())
  workspaceId     String?
  name            String
  email           String     @unique
  passwordHash    String
  isBillingExempt Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Owner {
  workspaceId       String?
  id                String                @id @default(cuid())
  name              String
  phone             String?
  email             String?
  companyName       String?
  accessType        OwnerAccessType       @default(share_link)
  /// Per-fee exceptions to the workspace share policy, as JSON:
  /// `{"Late fee":"MANAGER","Cleaning":"OWNER"}`.
  ///
  /// Stored as exceptions rather than a full map on purpose. An owner
  /// with no entry behaves exactly as they did before this existed, so
  /// adding the feature changes nobody's statement until it is used --
  /// and a fee added to the catalogue later inherits the workspace
  /// default instead of silently defaulting to withheld.
  feeShareOverrides String?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicles          Vehicle[]
  shareLinks        ShareLink[]
  ledgerItems       OwnerLedgerItem[]
  commissionRules   OwnerCommissionRule[]

  @@index([workspaceId])
}

model Vehicle {
  workspaceId                  String?
  id                           String                   @id @default(cuid())
  ownerId                      String?
  plateNumber                  String                   @unique
  nickname                     String
  brand                        String
  model                        String
  year                         Int
  vin                          String?
  status                       VehicleStatus            @default(available)
  /// Retired from sync, not merely out of service.
  ///
  /// `status: inactive` means a car is off the road for a while, and
  /// its trips are still real -- the CSV should keep correcting them.
  /// Archiving means the opposite: stop writing to this car at all. An
  /// import skips its rows and booking mail will not file new trips
  /// against it, so a car sold or handed back stops absorbing updates
  /// without its history being deleted.
  isArchived                   Boolean                  @default(false)
  turoListingName              String?
  // Which Turo account this car is listed on. Null is the main
  // account. A co-hosted listing lives on someone else's account, so
  // its trips never appear in this account's CSV export -- the mailbox
  // is the only place both accounts arrive together.
  turoAccount                  String?
  turoVehicleCode              String?
  purchasePrice                Float?
  ownerCommissionRate          Float?
  cleaningFee                  Float?
  pickupPassword               String?
  directBookingEnabled         Boolean                  @default(false)
  bookingDailyRate             Float?
  bookingInsuranceFee          Float?
  bookingDepositAmount         Float?
  bookingTaxName               String?
  bookingTaxRate               Float?
  /// Per-vehicle overrides of the workspace's booking policy. Null
  /// means "whatever the fleet does" -- an operator who changes the
  /// mileage allowance once should not have to visit every car, and
  /// the one car that genuinely differs should not force the others
  /// to be set explicitly.
  bookingWeeklyDiscountPercent Float?
  bookingMinimumRentalDays     Int?
  bookingDailyKmAllowance      Int?
  bookingExtraKmRate           Float?
  bookingIntro                 String?
  notes                        String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  workspace                    Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner                        Owner?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orders                       Order[]
  ownerLedgerItems             OwnerLedgerItem[]
  attachments                  OrderAttachment[]
  staffTasks                   StaffTask[]
  inspectionSessions           InspectionSession[]
  directBookingDocuments       DirectBookingDocument[]
  cleaningFeeRules             VehicleCleaningFeeRule[]
  messageTemplates             MessageTemplate[]
  calendarNotes                CalendarNote[]
  calendarFeeds                CalendarFeed[]
  inboundEmails                InboundEmail[]

  @@index([workspaceId])
}

model Order {
  workspaceId            String?
  id                     String                  @id @default(cuid())
  vehicleId              String
  importBatchId          String?
  source                 OrderSource
  externalOrderId        String?
  renterName             String
  renterPhone            String?
  pickupDatetime         DateTime
  returnDatetime         DateTime
  totalPrice             Float?
  depositAmount          Float?
  status                 OrderStatus             @default(booked)
  pickupLocation         String?
  returnLocation         String?
  paymentMethod          String?
  contractNumber         String?
  notes                  String?
  sourceMetadata         String?
  createdBy              String
  isArchived             Boolean                 @default(false)
  hasConflict            Boolean                 @default(false)
  ownerLedgerSyncedAt    DateTime?
  /// Set on every order created together as a repeating booking, so a
  /// monthly renter's twelve trips can be found and cancelled as one
  /// thing rather than twelve unrelated rows.
  recurringSeriesId      String?
  /// The renter's own way back into their booking.
  ///
  /// Minted for bookings taken on a public page, where there is no
  /// account to log into: the token is the whole authorisation, which
  /// is why it is looked up on its own and never accepted alongside an
  /// id. Null on orders typed in by an operator -- nobody outside has
  /// been given a link to those.
  renterToken            String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  importBatch            ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  vehicle                Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  ownerLedgerItems       OwnerLedgerItem[]
  attachments            OrderAttachment[]
  staffTasks             StaffTask[]
  directBookingDocuments DirectBookingDocument[]
  contractEnvelopes      ContractEnvelope[]
  inboundEmails          InboundEmail[]
  inspectionSessions     InspectionSession[]
  orderPayments          OrderPayment[]
  changeRequests         BookingChangeRequest[]

  @@index([workspaceId])
  @@index([workspaceId, isArchived])
  @@index([vehicleId, pickupDatetime, returnDatetime])
  @@index([source, externalOrderId])
  @@index([ownerLedgerSyncedAt])
}

model ImportBatch {
  workspaceId String?
  id          String     @id @default(cuid())
  fileName    String
  importedBy  String
  importedAt  DateTime   @default(now())
  totalRows   Int
  successRows Int
  failedRows  Int
  notes       String?
  mapping     String?
  failures    String?
  // Which Turo host account this export came from. An account only
  // exports its own listings, so a batch is always about exactly one
  // of them -- and a co-hosted car imported without this tag would be
  // filed as a main-account vehicle and stop matching its own mail.
  //
  // Distinct from the vehicle's owner, which is who gets paid. A car
  // listed on Kevin's account can belong to any of the owners; the two
  // do not constrain each other.
  turoAccount String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([workspaceId])
}

model TuroSyncConfig {
  workspaceId           String    @unique
  id                    String    @id @default(cuid())
  csvUrl                String?
  csvYear               Int?
  csvPath               String?
  csvAuthHeader         String?
  csvHeaders            String?
  csvMapping            String?
  createMissingVehicles Boolean   @default(true)
  archiveMissingOrders  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A management commission agreement, as of a date.
///
/// Rates get renegotiated, and a new rate must not silently rewrite
/// what was already settled. So this is a history rather than a field:
/// each row says "from this date, these terms", and an order is priced
/// by whichever row was in force on the day the trip started. Change
/// the rate and last quarter's statements still reconcile.
model OwnerCommissionRule {
  id            String                   @id @default(cuid())
  workspaceId   String?
  ownerId       String
  /// Stored as a fraction (0.2 = 20%), matching Vehicle.ownerCommissionRate.
  rate          Float
  settlement    OwnerSettlementDirection @default(COMPANY_COLLECTS)
  /// Inclusive. A trip starting on this date uses this rule.
  effectiveFrom DateTime
  note          String?
  createdBy     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner     Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// One set of terms per owner per start date; re-saving the same date
  /// edits that rule instead of stacking a second one behind it.
  @@unique([ownerId, effectiveFrom])
  @@index([workspaceId])
  @@index([ownerId, effectiveFrom])
}

/// A cleaning fee, as of a date.
///
/// Same reasoning as OwnerCommissionRule and the same hazard: the fee
/// is a price that changes, and a plain field on the vehicle would
/// silently reprice every trip that car has ever run the moment it is
/// edited. Trips are keyed by the day they started, so raising the fee
/// today leaves last month's statements alone.
model VehicleCleaningFeeRule {
  id            String   @id @default(cuid())
  workspaceId   String?
  vehicleId     String
  amount        Float
  /// Inclusive. A trip starting on this date is charged this fee.
  effectiveFrom DateTime
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, effectiveFrom])
  @@index([workspaceId])
  @@index([vehicleId, effectiveFrom])
}

/// A real booking whose car we could not identify.
///
/// Booking mail names a model and never a plate, so a fleet running
/// four Dodge Journey 2014s gives the matcher nothing to choose
/// between. Guessing files a real trip against the wrong car -- wrong
/// plate to the guest, a phantom conflict on the calendar, the wrong
/// owner credited -- so it refuses.
///
/// Refusing used to mean the booking vanished: it was counted in the
/// run's outcome and dropped. The trip is real either way, and a
/// calendar missing a booking that exists is its own kind of wrong.
/// So it lands here instead, visible and assignable, until one of
/// three things resolves it:
///
///   - someone picks the car by hand,
///   - a CSV import arrives with the plate,
///   - or the fleet changes and the model resolves to one car.
///
/// Keyed by reservation, so re-reading the same mail updates this row
/// rather than stacking duplicates -- the order applier re-derives the
/// whole picture on every run.
model PendingOrder {
  id              String      @id @default(cuid())
  workspaceId     String
  externalOrderId String
  renterName      String
  renterPhone     String?
  pickupDatetime  DateTime
  returnDatetime  DateTime
  pickupLocation  String?
  status          OrderStatus @default(booked)
  /// The vehicle as the email wrote it, e.g. "Dodge Journey 2014".
  vehicleText     String
  /// Which Turo account the mail came from; null is the main one.
  turoAccount     String?
  /// How many cars answered to `vehicleText`. Zero means the fleet is
  /// missing the car; more than one means it cannot be told apart.
  matchCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalOrderId])
  @@index([workspaceId, pickupDatetime])
}

model OwnerLedgerItem {
  workspaceId        String?
  id                 String               @id @default(cuid())
  ownerId            String
  vehicleId          String?
  orderId            String?
  kind               OwnerLedgerKind
  amount             Float
  occurredAt         DateTime
  note               String?
  receiptUrl         String?
  receiptPathname    String?
  receiptFilename    String?
  receiptContentType String?
  receipts           OwnerLedgerReceipt[]
  isAuto             Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workspace          Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  order              Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([ownerId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([orderId])
}

model OwnerLedgerReceipt {
  workspaceId String?
  id          String          @id @default(cuid())
  itemId      String
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  uploadedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  item        OwnerLedgerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([itemId])
}

model OrderAttachment {
  workspaceId String?
  id          String              @id @default(cuid())
  orderId     String?
  vehicleId   String?
  kind        OrderAttachmentKind
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  isArchived  Boolean             @default(false)
  /// Minted on demand so one photo can be sent to a renter or an
  /// adjuster without handing over an account. Null means the file has
  /// never been shared; clearing it revokes every link already sent.
  shareToken  String?             @unique
  sharedAt    DateTime?
  uploadedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([orderId, kind])
  @@index([vehicleId, kind])
  @@index([isArchived])
  @@index([uploadedAt])
}

model DirectBookingDocument {
  workspaceId       String?
  id                String     @id @default(cuid())
  vehicleId         String
  orderId           String?
  checkoutSessionId String?
  draftId           String
  kind              String
  pathname          String
  filename          String?
  contentType       String?
  size              Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  order             Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([vehicleId])
  @@index([orderId])
  @@index([checkoutSessionId])
  @@index([draftId])
}

model StaffMember {
  workspaceId               String?
  id                        String              @id @default(cuid())
  name                      String
  phone                     String?
  email                     String?
  role                      String?
  color                     String              @default("#3456df")
  notes                     String?
  pinnedMessage             String?
  isActive                  Boolean             @default(true)
  sortOrder                 Int                 @default(0)
  shareToken                String?
  miniProgramCode           String?             @unique
  wechatOpenId              String?             @unique
  wechatNotificationEnabled Boolean             @default(false)
  wechatSubscribedAt        DateTime?
  wechatBoundAt             DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  workspace                 Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks                     StaffTask[]
  inspectionSessions        InspectionSession[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, isActive, sortOrder])
  @@index([shareToken])
  @@index([miniProgramCode])
  @@index([wechatOpenId])
}

model StaffTask {
  workspaceId  String?
  id           String                @id @default(cuid())
  staffId      String?
  parentTaskId String?
  vehicleId    String?
  orderId      String?
  staffLabel   String?
  vehicleLabel String?
  orderLabel   String?
  title        String
  details      String?
  dueDatetime  DateTime?
  timeWindow   String?
  status       StaffTaskStatus       @default(todo)
  priority     StaffTaskPriority     @default(normal)
  category     String?
  sortOrder    Int                   @default(0)
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  staff        StaffMember?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  parentTask   StaffTask?            @relation("StaffTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     StaffTask[]           @relation("StaffTaskSubtasks")
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attachments  StaffTaskAttachment[]

  @@index([workspaceId, status])
  @@index([parentTaskId, sortOrder])
  @@index([staffId, dueDatetime])
  @@index([vehicleId, dueDatetime])
  @@index([orderId])
}

model StaffTaskAttachment {
  workspaceId String?
  id          String              @id @default(cuid())
  taskId      String
  kind        OrderAttachmentKind @default(photo)
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  isArchived  Boolean             @default(false)
  uploadedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  task        StaffTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId, kind])
  @@index([isArchived])
  @@index([uploadedAt])
}

model StaffTaskNotificationTemplate {
  workspaceId          String    @unique
  id                   String    @id @default(cuid())
  emailSubjectTemplate String?
  emailBodyTemplate    String?
  smsBodyTemplate      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContractTemplate {
  workspaceId       String?
  id                String                      @id @default(cuid())
  name              String
  description       String?
  pdfUrl            String
  pdfPathname       String
  pdfFilename       String?
  pdfContentType    String?
  pdfSize           Int?
  sourceType        String                      @default("PDF")
  sourceUrl         String?
  sourcePathname    String?
  sourceFilename    String?
  sourceContentType String?
  sourceSize        Int?
  editableContent   String?
  pageCount         Int                         @default(1)
  pageSizes         Json?
  active            Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workspace         Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields            ContractTemplateField[]
  recipients        ContractTemplateRecipient[]
  envelopes         ContractEnvelope[]

  @@index([workspaceId, active])
  @@index([createdAt])
}

model ContractTemplateRecipient {
  id           String           @id @default(cuid())
  templateId   String
  name         String
  email        String
  signingOrder Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  template     ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, signingOrder])
}

model ContractTemplateField {
  id             String               @id @default(cuid())
  templateId     String
  type           ContractFieldType
  label          String
  required       Boolean              @default(true)
  recipientIndex Int?
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  placeholder    String?
  defaultValue   String?
  fontSize       Float?
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  template       ContractTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values         ContractFieldValue[]

  @@index([templateId, page, sortOrder])
}

model ContractEnvelope {
  workspaceId          String?
  id                   String                 @id @default(cuid())
  templateId           String
  orderId              String?
  title                String
  message              String?
  status               ContractEnvelopeStatus @default(DRAFT)
  signedPdfUrl         String?
  signedPdfPathname    String?
  signedPdfFilename    String?
  signedPdfContentType String?
  signedPdfSize        Int?
  signedPdfSha256      String?
  sentAt               DateTime?
  completedAt          DateTime?
  voidedAt             DateTime?
  expiresAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workspace            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template             ContractTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  order                Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recipients           ContractRecipient[]
  values               ContractFieldValue[]
  auditLogs            ContractAuditLog[]

  @@index([workspaceId, status])
  @@index([orderId])
  @@index([createdAt])
}

model ContractRecipient {
  id           String                  @id @default(cuid())
  envelopeId   String
  name         String
  email        String
  signingOrder Int                     @default(1)
  token        String                  @unique
  status       ContractRecipientStatus @default(PENDING)
  viewedAt     DateTime?
  signedAt     DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  envelope     ContractEnvelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  values       ContractFieldValue[]
  auditLogs    ContractAuditLog[]

  @@index([envelopeId, signingOrder])
  @@index([email])
}

model ContractFieldValue {
  id          String                @id @default(cuid())
  envelopeId  String
  fieldId     String
  recipientId String?
  value       String?
  signature   String?
  checked     Boolean?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  envelope    ContractEnvelope      @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  field       ContractTemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recipient   ContractRecipient?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([envelopeId, fieldId])
  @@index([recipientId])
}

model ContractAuditLog {
  workspaceId String?
  id          String             @id @default(cuid())
  envelopeId  String
  recipientId String?
  event       ContractAuditEvent
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  envelope    ContractEnvelope   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient   ContractRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([envelopeId, createdAt])
  @@index([workspaceId, createdAt])
}

model ContractTextPreset {
  workspaceId String?
  id          String     @id @default(cuid())
  label       String
  value       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ShareLink {
  workspaceId  String?
  id           String          @id @default(cuid())
  ownerId      String
  token        String          @unique
  passwordHash String?
  expiresAt    DateTime?
  isActive     Boolean         @default(true)
  visibility   ShareVisibility @default(standard)
  createdBy    String
  createdAt    DateTime        @default(now())
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner        Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
