model WorkspaceBilling {
  id                            String                    @id @default(cuid())
  workspaceId                   String?                   @unique
  freeVehicleSlots              Int                       @default(5)
  bonusVehicleSlots             Int                       @default(0)
  purchasedVehicleSlots         Int                       @default(0)
  stripeCustomerId              String?                   @unique
  stripeSubscriptionId          String?                   @unique
  stripeSubscriptionItemId      String?
  stripePriceId                 String?
  stripePortalConfigurationId   String?
  stripeLatestCheckoutSessionId String?
  status                        WorkspaceBillingStatus    @default(inactive)
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  lastCheckoutAt                DateTime?
  lastPaidAt                    DateTime?
  // Stripe Connect fields — per-workspace payout account for direct-booking
  // revenue. The platform (site owner) collects a flat application fee and the
  // rest is settled on-behalf-of the host's Connect account, so renters see
  // the host's business name on their statement.
  stripeConnectAccountId        String?                   @unique
  stripeConnectCountry          String?
  stripeConnectChargesEnabled   Boolean                   @default(false)
  stripeConnectPayoutsEnabled   Boolean                   @default(false)
  stripeConnectDetailsSubmitted Boolean                   @default(false)
  stripeConnectOnboardedAt      DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  workspace                     Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  couponRedemptions             BillingCouponRedemption[]
}

model BillingCouponRedemption {
  id                 String           @id @default(cuid())
  workspaceBillingId String
  code               String           @unique
  couponType         String
  bonusVehicleSlots  Int              @default(0)
  metadata           String?
  createdAt          DateTime         @default(now())
  workspaceBilling   WorkspaceBilling @relation(fields: [workspaceBillingId], references: [id], onDelete: Cascade)

  @@index([workspaceBillingId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("registration")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model ActivityLog {
  workspaceId String?
  id          String     @id @default(cuid())
  actor       String
  action      String
  entityType  String
  entityId    String
  metadata    String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// Sliding-window rate limit for sensitive auth surfaces (login,
// share-link unlock). One row per (scope, identifier). Old rows are
// best-effort GC'd inside `lib/rate-limit.ts` when checked. The model
// is intentionally generic so the same primitive covers any future
// throttled flow (e.g. password-reset request).
model RateLimitAttempt {
  id            String   @id @default(cuid())
  // Stable bucket name, e.g. "login_email" / "login_ip" / "share_unlock".
  scope         String
  // Bucket key within the scope, e.g. lowercased email, share token,
  // or client IP. Combined with scope it forms a unique row.
  identifier    String
  // Number of failed attempts within the current window. Resets to 0
  // by deleting the row once the window expires.
  attempts      Int      @default(0)
  // Start of the active window. New row → now(); refreshed when a row
  // ages past its window before the next failure is recorded.
  windowStart   DateTime @default(now())
  // Wall clock of the most recent failure, useful for alerting.
  lastAttemptAt DateTime @default(now())

  @@unique([scope, identifier])
  @@index([windowStart])
}

// ---------------------------------------------------------------------
// AI assistant + Turo inbox
// ---------------------------------------------------------------------

// Turo gives hosts no API and no webhooks, but it does email every
// material event: guest messages, booking created / modified /
// cancelled, and support notices. Those land in the operator's Gmail.
// Pulling them in over IMAP is the only near-real-time channel Turo
// leaves open, so this table is TATO's Turo event stream.
enum InboundEmailKind {
  GUEST_MESSAGE
  BOOKING_CREATED
  BOOKING_MODIFIED
  BOOKING_CANCELLED
  TRIP_STARTED
  TRIP_ENDED
  PAYOUT
  SUPPORT
  OTHER
}

model InboundEmail {
  id          String @id @default(cuid())
  workspaceId String

  // RFC 5322 Message-ID. The dedupe key — an IMAP poll that overlaps a
  // previous run, or a reconnect that replays a range, must not create
  // a second row. Unique per workspace rather than globally so two
  // workspaces watching the same shared mailbox don't collide.
  messageId   String
  fromAddress String
  fromName    String?
  subject     String
  receivedAt  DateTime
  // Plain-text body, truncated at ingest. We deliberately do not store
  // the HTML part or attachments: this table exists to drive alerts and
  // assistant answers, not to be a mail archive.
  bodyText    String

  // Populated by the Kimi extraction pass. `kind` stays OTHER and
  // `parsedAt` stays null when extraction fails, so a failed parse is
  // visible and retryable rather than silently mislabelled.
  kind           InboundEmailKind @default(OTHER)
  parsedAt       DateTime?
  // Extracted fields as JSON: guest name, reservation id, vehicle,
  // dates, amount — whichever the email actually carried.
  parsed         String?
  // Set once the assistant has surfaced this to the operator.
  acknowledgedAt DateTime?

  // Read straight off the subject, which Turo generates from a fixed
  // template. Present long before the model pass runs, so a message is
  // attributable to a guest and a car the moment it lands.
  guestName   String?
  // The co-host prefix, normalised: "(Kevin's vehicle) - ..." becomes
  // "kevin". Null is the main account. This is the only field in the
  // whole feed that says which Turo account a trip belongs to.
  turoAccount String?

  // The guest's profile photo, lifted from the HTML part of the
  // notification. Only new mail can carry one: the archive was
  // ingested storing the plain-text alternative alone, and the photo
  // never appears there. A thread without one falls back to initials
  // rather than a blank circle.
  avatarUrl String?

  // What the guest actually wrote, lifted out of the notification
  // template. The page used to show a model's summary in its place,
  // which is a paraphrase of the one thing on screen that has to be
  // read exactly.
  guestText String?

  // The guest's own words in Chinese. Separate from summaryZh rather
  // than replacing it: the two are translations of different source
  // text, and the rows translated before guestText existed hold a
  // rendering of the summary. Giving the new thing its own column
  // means every row retranslates once, from the right source, without
  // deleting anything or needing a heuristic to guess which cached
  // translations went stale.
  guestTextZh String?

  // The summary translated to Chinese, cached because the operator
  // reads the same thread more than once and a translation is a model
  // call. Null means "not translated yet", not "translation failed" --
  // the two look identical from the page and only one is worth
  // retrying.
  summaryZh String?
  // The vehicle the subject named, when exactly one in the fleet
  // matched. Null when the listing text matched several -- several
  // cars of one model is normal here, and guessing between them would
  // put the message against the wrong car.
  vehicleId String?

  // The link Turo put in the notification body. Kept as sent rather
  // than constructed from an id, so a routing change on their side
  // does not silently produce dead links on ours.
  turoLink String?

  // Best-effort link back to the order this email is about: an exact
  // join on the reservation id for booking mail, and a name + vehicle
  // + date-window match for guest messages, which carry no id. Null
  // when the email predates the order's import or when the match was
  // ambiguous -- showing a message against the wrong trip is worse
  // than showing it against none.
  orderId String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, messageId])
  @@index([workspaceId, receivedAt])
  @@index([workspaceId, kind, acknowledgedAt])
  @@index([orderId])
  @@index([vehicleId])
  // The guest-message page groups by guest; this is the index it reads.
  @@index([workspaceId, kind, guestName])
}

model AssistantThread {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([workspaceId, userId, updatedAt])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id        String               @id @default(cuid())
  threadId  String
  role      AssistantMessageRole
  content   String
  // Which data the assistant consulted to answer, as JSON. Shown in the
  // UI so the operator can tell an answer grounded in their fleet from
  // one the model invented.
  context   String?
  createdAt DateTime             @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum AssistantAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Something the operator should look at. Written by the alert scan, not
// by the model — the model only phrases them. Keeping detection in
// plain code means an alert never fires because of a hallucination, and
// never fails to fire because the model was having an off day.
model AssistantAlert {
  id          String @id @default(cuid())
  workspaceId String

  // Stable identity for a given real-world condition, e.g.
  // "conflict:<orderId>" or "gmail_sync_failed". Lets a repeated scan
  // update the existing alert instead of stacking duplicates.
  dedupeKey String
  severity  AssistantAlertSeverity @default(INFO)
  title     String
  body      String
  // Deep link into the app, e.g. /orders?q=<reservation>.
  href      String?

  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  notifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, resolvedAt, severity])
}

/// A credential for an automated client -- the browser agent that logs
/// into Turo and pushes back what the mailbox cannot see.
///
/// Separate from the operator's session on purpose. An agent runs
/// unattended on someone's laptop, so its credential has to be
/// revocable on its own, without logging anyone out, and has to leave
/// a trail of when it was last used. A shared secret in an env var --
/// which is how the Gmail sync authenticates -- cannot do either.
model AgentToken {
  id          String    @id @default(cuid())
  workspaceId String
  /// Human label: which machine, which purpose.
  name        String
  /// SHA-256 of the token. The plaintext is shown once at creation and
  /// never stored: a leaked database should not hand over working
  /// credentials as well as data.
  tokenHash   String    @unique
  /// First 8 characters, so a token can be identified in a list
  /// without being usable from it.
  tokenPrefix String
  /// What this token may do. Coarse on purpose -- an agent that can
  /// write conversations has no business importing financials.
  scopes      String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum TuroMessageDirection {
  /// From the guest to us. Also arrives by email; the scraped copy is
  /// the fuller one, since email carries only what Turo chose to quote.
  inbound
  /// From us to the guest. Exists nowhere else: Turo sends no
  /// notification when the host replies, so without the browser agent
  /// every conversation in this system is one-sided.
  outbound
}

/// One message in a Turo conversation, as scraped from the site.
///
/// Keyed by reservation rather than by guest: Turo threads a
/// conversation to a trip, and the same guest booking twice has two
/// conversations. That also makes the join to `Order` exact.
model TuroConversationMessage {
  id            String               @id @default(cuid())
  workspaceId   String
  /// Turo's reservation id, as it appears in the URL.
  reservationId String
  /// Turo's own id for the message when the page exposes one. Null
  /// falls back to a content hash, so a re-scrape updates rather than
  /// duplicates.
  externalId    String
  direction     TuroMessageDirection
  authorName    String?
  body          String
  sentAt        DateTime
  /// Chinese, filled in by the same pass that translates inbound mail.
  bodyZh        String?
  /// Which agent run wrote this, for tracing a bad scrape back to its
  /// source.
  source        String?
  createdAt     DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, reservationId, externalId])
  @@index([workspaceId, reservationId, sentAt])
  @@index([workspaceId, sentAt])
}

/// A canned reply, ready to paste into Turo's own message box.
///
/// TATO cannot send a Turo message on anyone's behalf -- write access
/// to that channel does not exist -- so a template's job stops at
/// being fast to find and easy to copy. `vehicleId` is what "locked to
/// a car" means: null is a general template offered for any
/// conversation, and a value narrows it to the one car it actually
/// describes, for content that would be wrong on any other -- a gate
/// code, a parking spot, a specific model's quirks.
model MessageTemplate {
  workspaceId String?
  id          String     @id @default(cuid())
  vehicleId   String?
  label       String
  content     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([vehicleId])
}

/// A staff member's walk around one car, at one end of one trip.
///
/// The photographs themselves are the evidence; this is the index that makes
/// them findable and the record of what the server made of them when they
/// arrived. Turo rejects claim photos whose metadata lacks date, time or
/// geolocation -- and rejected this fleet's once -- so every shot carries the
/// server's own reading of those fields, taken from the bytes rather than
/// from what the phone claimed.
model InspectionSession {
  workspaceId      String?
  id               String         @id @default(cuid())
  /// The id the phone generated for its local archive. Uploads are idempotent
  /// on this: a retry after a dropped connection resumes the same session
  /// instead of starting a second one halfway through a walk-around.
  clientSessionId  String         @unique
  vehicleId        String?
  orderId          String?
  /// What the photographer typed. Kept even when `vehicleId` resolves, because
  /// it is what they saw on the plate at the time.
  vehicleLabel     String
  staffId          String?
  staffLabel       String
  kind             InspectionKind
  deviceModel      String
  appVersion       String
  startedAt        DateTime
  /// IANA zone the phone was in, so a local capture time can be placed.
  timeZone         String
  /// How much of the car's surface the phone reckons was photographed.
  ///
  /// ⚠️ Stored as a claim, not a finding. Coverage is computed from camera
  /// poses that only ever existed on the device, so unlike the digest and the
  /// EXIF there is nothing here to check it against. What the server *can*
  /// verify -- and does, at completion -- is the photograph counts, because
  /// it holds the photographs.
  coverageFraction Float?
  /// Set only once the shot list is complete. An incomplete session is not
  /// evidence of anything and must not read as one.
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  staff     StaffMember?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  shots     InspectionShot[]

  @@index([workspaceId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([orderId])
  @@index([completedAt])
}

enum InspectionKind {
  checkout
  checkin
}

/// One photograph, and what the server independently found in it.
model InspectionShot {
  workspaceId String?
  id          String  @id @default(cuid())
  sessionId   String
  /// Which part of the car this photograph turned out to document, worked out
  /// on the device from the camera's pose *after* the shutter.
  ///
  /// Never a slot the photographer was sent to: there is no shot list. It
  /// exists so the review page can still put the handover and the return of
  /// the same corner side by side.
  region      String
  /// Position in the session, from 1.
  sequence    Int
  /// Whether the photograph cleared the quality gate. A rejected one is still
  /// archived -- it is part of the record of how the walk-around went -- but
  /// it does not count towards the floors.
  accepted    Boolean @default(true)
  pathname    String
  filename    String
  byteCount   Int
  /// Computed here, over the bytes that actually arrived -- never copied from
  /// the request. An archive whose digests came from the uploader would prove
  /// nothing.
  sha256      String

  // --- What the server read out of the file ---------------------------------
  capturedAt       DateTime?
  /// The local timestamp exactly as written, e.g. `2026:09:09 17:26:40`.
  localCaptureTime String?
  utcOffset        String?
  latitude         Float?
  longitude        Float?
  cameraMake       String?
  cameraModel      String?
  /// JSON array of what an insurer would find missing, e.g. `["noLocation"]`.
  /// Empty is the only state that survives a claim unread.
  evidenceGaps     Json
  /// The phone's clock minus the server's at upload, in seconds. A phone clock
  /// is user-settable, so EXIF times are only as good as the device that wrote
  /// them; this is the one cross-check the server can make alone.
  clockSkewSeconds Int?
  receivedAt       DateTime  @default(now())

  // --- What the phone reported ----------------------------------------------
  //
  // Kept beside the server's own reading rather than instead of it. Where the
  // two disagree, the server's wins and the disagreement is itself worth
  // seeing.
  reportedSharpness Float?
  /// JSON array of quality problems the app detected, e.g. `["blurry"]`.
  reportedIssues    Json
  /// JSON array of problems a person waved through, with their name on it.
  acceptedDespite   Json
  /// `writtenAtCapture` or `stampedAfterCapture`; which writer put the
  /// metadata in. Per shot, because the answer is decided on the device.
  metadataPath      String

  createdAt DateTime @default(now())

  session   InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@index([workspaceId])
  @@index([sessionId, accepted])
  @@index([sessionId, region])
  @@index([sha256])
}

// ---------------------------------------------------------------------
// Notification hub
//
// One WeChat mini program is the channel; three systems send through it
// (TATO, HostHub, the wash bay), and eventually HostHub customers will
// too. The hub owns the WeChat credentials, the subscriber bindings and
// the subscribe-message quota, and knows nothing about what any caller's
// message means.
//
// Nothing in this block relates to a model outside it. That is
// deliberate: the hub is a shared dependency of systems that deploy
// separately, so the day it moves into its own service should be a file
// move and a connection string, not an untangling.
// ---------------------------------------------------------------------

/// A mini program the hub can send through.
///
/// More than one row exists so that "which mini program does this app
/// send through" stays a configuration change. Today every app points at
/// the same one; when HostHub is sold it gets its own appid under its
/// own company, and the only edit is `NotifyApp.miniProgramId`.
model NotifyMiniProgram {
  id           String  @id @default(cuid())
  /// The WeChat appid (wx...).
  appId        String  @unique
  name         String
  /// Name of the environment variable holding the app secret, not the
  /// secret itself -- a secret in the database is a secret in every
  /// backup, and this table is one an admin screen will eventually edit.
  secretEnvVar String  @default("WECHAT_MINIPROGRAM_APP_SECRET")
  /// `miniprogram_state` on send: formal | trial | developer.
  state        String  @default("formal")
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps      NotifyApp[]
  templates NotifyTemplate[]
  quotas    NotifySubscribeQuota[]
}

/// The mapping from a logical template name to a real WeChat template.
///
/// Callers ask for `"task"`, never for `tmpl_Xyz123`. Subscribe-message
/// templates belong to an appid, so the same logical name resolves to a
/// different id under a different mini program -- which is the whole
/// reason callers are not allowed to name the real one.
model NotifyTemplate {
  id            String  @id @default(cuid())
  miniProgramId String
  /// Logical name: "task" | "alert" | "digest". Kept few on purpose --
  /// a mini program has a ceiling on how many templates it may adopt,
  /// and `requestSubscribeMessage` accepts at most three ids per call,
  /// so three logical templates is what one tap can top up.
  key           String
  /// The template id from the WeChat console.
  templateId    String
  /// JSON object mapping logical field -> WeChat field, e.g.
  /// {"title":"thing1","due":"time2","source":"thing3"}. WeChat field
  /// names differ per template even for the same meaning, so the map
  /// lives beside the template rather than in code.
  fieldMap      String
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miniProgram NotifyMiniProgram @relation(fields: [miniProgramId], references: [id], onDelete: Cascade)

  @@unique([miniProgramId, key])
}

/// A sending system. Holds API keys, owns channels, sees nothing else.
///
/// Today: `tato`, `hosthub`, `washbay`. After HostHub is sold, one row
/// per customer -- which is why isolation is enforced here rather than
/// left to callers behaving.
model NotifyApp {
  id            String  @id @default(cuid())
  miniProgramId String
  /// Stable slug used in logs and in channel keys.
  key           String  @unique
  name          String
  /// JSON: logical field -> the label the mini program shows for it,
  /// e.g. {"room":"房间"}. Merged over a built-in set covering the
  /// fields every system sends.
  ///
  /// Here rather than in the mini program because each app owns its own
  /// field vocabulary, and a label baked into the client would mean a
  /// WeChat review every time a new system sends a field nobody had
  /// named yet -- for the sake of one word.
  fieldLabels   String  @default("{}")
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miniProgram NotifyMiniProgram @relation(fields: [miniProgramId], references: [id], onDelete: Cascade)
  apiKeys     NotifyApiKey[]
  channels    NotifyChannel[]
  deliveries  NotifyDelivery[]

  @@index([miniProgramId])
}

/// A credential belonging to one app.
///
/// Same shape as AgentToken and for the same reason: the wash bay's key
/// lives on a machine in a car park, and losing that machine must not
/// mean rotating HostHub's credentials too.
model NotifyApiKey {
  id          String    @id @default(cuid())
  appId       String
  /// Human label: which system, which deployment.
  name        String
  /// SHA-256 of the key. The plaintext is shown once at creation.
  tokenHash   String    @unique
  /// First characters, so a key can be identified in a list without
  /// being usable from it.
  tokenPrefix String
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  app NotifyApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

/// The routing unit: who a message is addressed to.
///
/// A channel is as coarse or as fine as the caller wants -- one per
/// person ("staff:cl9x..."), one per role ("cleaning"), one per
/// severity ("alerts"). Subscribers are many-to-many with it, so a
/// channel can be shared by a whole crew and a person can watch
/// channels belonging to several apps without those apps learning
/// about each other.
model NotifyChannel {
  id       String  @id @default(cuid())
  appId    String
  /// Caller-chosen key, unique within the app. This is what `POST
  /// /v1/notify` addresses.
  key      String
  name     String
  /// Short code a person types, or a mini program QR encodes, to
  /// subscribe. Unique across every app because the person typing it
  /// has not told us which app they belong to yet.
  bindCode String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app           NotifyApp            @relation(fields: [appId], references: [id], onDelete: Cascade)
  subscriptions NotifySubscription[]
  deliveries    NotifyDelivery[]

  @@unique([appId, key])
  @@index([bindCode])
}

/// One WeChat user watching one channel.
model NotifySubscription {
  id         String    @id @default(cuid())
  channelId  String
  /// openid, which is scoped to the mini program the channel's app
  /// points at. Two rows may hold the same string for different people
  /// if the apps sit under different mini programs, so this is never
  /// looked up without a channel or a mini program in hand.
  openId     String
  /// Who this is, for the admin list. Supplied by the caller at bind
  /// time; the hub has no user directory of its own.
  label      String?
  /// Set by the subscriber to stop messages without unbinding.
  mutedUntil DateTime?

  createdAt DateTime @default(now())

  channel NotifyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, openId])
  @@index([openId])
}

/// Remaining subscribe-message sends for one person and one template.
///
/// WeChat's one-off subscription grants exactly one message per
/// authorisation, and the grants accumulate. Without this table the
/// server believes it may send forever, sends once, and then fails
/// silently with 43101 for weeks -- which is what the first version of
/// the TATO integration did.
///
/// Keyed on the mini program rather than the app: the quota belongs to
/// the (openid, template) pair at WeChat, so two apps under one mini
/// program genuinely do draw from the same pool, and pretending
/// otherwise would only make the accounting lie.
model NotifySubscribeQuota {
  id            String    @id @default(cuid())
  miniProgramId String
  openId        String
  /// Logical template key, matching NotifyTemplate.key.
  templateKey   String
  remaining     Int       @default(0)
  lastGrantedAt DateTime?
  lastSpentAt   DateTime?

  updatedAt DateTime @updatedAt

  miniProgram NotifyMiniProgram @relation(fields: [miniProgramId], references: [id], onDelete: Cascade)

  @@unique([miniProgramId, openId, templateKey])
  @@index([openId])
}

/// One attempt to put one message in front of one person.
///
/// The hub is a channel, not a message store, and this row is the
/// smallest thing that keeps that true: enough payload for the detail
/// page to render without calling back to a system that may be on a
/// private network, plus the delivery outcome that quota accounting,
/// retries and deduplication all need. It expires on its own.
model NotifyDelivery {
  id          String    @id @default(cuid())
  appId       String
  channelId   String
  openId      String
  templateKey String
  /// Caller-supplied idempotency key. Unique per app and person, since
  /// one call to a shared channel fans out into one row per subscriber;
  /// a retry after a timeout must not cost any of them a second
  /// subscription.
  dedupeKey   String?
  /// high | normal | low. When quota is short, only `high` spends it.
  priority    String    @default("normal")
  /// JSON: the rendered fields, kept short by construction -- a
  /// subscribe message has room for a title and a few values.
  payload     String
  /// JSON: where tapping the message goes.
  page        String?
  /// sent | no_quota | duplicate | muted | failed | skipped
  status      String
  /// WeChat errcode and message when the send failed.
  errcode     String?
  sentAt      DateTime?
  /// When this row may be deleted. The detail page stops resolving
  /// then, which is the intended lifetime of a notification.
  expiresAt   DateTime

  createdAt DateTime @default(now())

  app     NotifyApp     @relation(fields: [appId], references: [id], onDelete: Cascade)
  channel NotifyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([appId, dedupeKey, openId])
  @@index([appId, dedupeKey])
  @@index([openId, createdAt])
  @@index([channelId, createdAt])
  @@index([expiresAt])
}

/// A note pinned to one vehicle over a run of days on the calendar.
///
/// Not a price, not a booking and not a block: it writes nothing
/// anywhere else and takes no dates out of sale. It puts words on the
/// grid where the operator reads them -- "winter tyres on the 3rd",
/// "insurance lapses" -- which previously could only be done by
/// creating a fake order, and a fake order pollutes every revenue
/// figure it touches.
model CalendarNote {
  workspaceId String?
  id          String     @id @default(cuid())
  vehicleId   String
  /// Inclusive at both ends. A note covers whole days, not instants:
  /// it is read against the day columns, and storing a timestamp
  /// would make the band's edges depend on the reader's timezone.
  startDate   DateTime
  endDate     DateTime
  text        String
  isArchived  Boolean    @default(false)
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([vehicleId, startDate, endDate])
  @@index([workspaceId, isArchived])
}

/// One instalment against an order.
///
/// A long rental is not one payment, and recording it as a single
/// `totalPrice` loses the only question anybody asks about it midway
/// through: how much is still owed. Rows here are the answer.
model OrderPayment {
  workspaceId String?
  id          String     @id @default(cuid())
  orderId     String
  amount      Float
  /// Null while the instalment is still expected. Setting it is what
  /// "this one has been paid" means.
  paidAt      DateTime?
  /// When this instalment falls due. Null for rows an operator typed
  /// in by hand, which are usually a record of money already taken;
  /// set on the ones a long booking generates, where the schedule is
  /// the entire point of writing them down.
  dueAt       DateTime?
  payer       String?
  method      String?
  note        String?
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([orderId])
}

/// A subscribable calendar URL.
///
/// Read-only and outbound only. Turo publishes no iCal feed to import
/// from, so there is nothing to bring in; what this solves is the
/// other direction -- an owner or a driver seeing a car's schedule in
/// the calendar app they already look at, without an account here.
///
/// The token is the whole authorisation, which is why a feed is
/// scoped to one vehicle when `vehicleId` is set. Handing an owner a
/// fleet-wide URL to show them their own car would show them
/// everybody's.
model CalendarFeed {
  workspaceId String?
  id          String     @id @default(cuid())
  token       String     @unique
  /// Null means the whole fleet.
  vehicleId   String?
  label       String?
  isActive    Boolean    @default(true)
  lastReadAt  DateTime?
  createdBy   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([vehicleId])
}

/// A public, brandable rental website for one workspace.
///
/// Direct booking started as one shareable link per vehicle -- a link
/// you send to somebody who already knows you. A site is the other
/// thing: a front door a stranger can find. Same cars, same
/// availability, same checkout. What this adds is a domain that is not
/// ours, a brand that is not TATO's, and pages a crawler can read.
///
/// A site keeps its `slug` after a domain is bound, so it is reachable
/// before the operator has bought a domain and stays reachable when
/// their DNS breaks.
model RentalSite {
  id          String  @id @default(cuid())
  workspaceId String  @unique
  /// Reachable at `/s/<slug>` on the platform host, always.
  slug        String  @unique
  /// A custom domain the operator points at us, stored without
  /// protocol, port or a leading `www.`. Null until one is bound.
  domain      String? @unique
  /// Off by default, and enforced on every public read. A site whose
  /// cars have no daily rate is worse than no site at all, so
  /// publishing is a deliberate act rather than a side effect of
  /// filling in a brand name.
  isPublished Boolean @default(false)

  brandName      String
  tagline        String?
  /// Hero copy. Also the fallback `<meta name="description">`, which is
  /// why it is prose rather than a list of features.
  description    String?
  logoPathname   String?
  /// Hex, `#rrggbb`. Drives the one accent the public pages use; the
  /// rest of the palette is shared so a bad value cannot make a site
  /// unreadable.
  accentColor    String?
  contactEmail   String?
  contactPhone   String?
  contactAddress String?
  /// Footer prose: cancellation terms, insurance notes, licence
  /// numbers -- whatever the operator is required to say and we cannot
  /// know.
  footerNote     String?
  /// GA4 / Google Ads measurement id. Empty emits no tag at all rather
  /// than an empty one that still loads gtag and still sets cookies.
  analyticsId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// The confirmation a renter receives after paying on a booking page.
///
/// One row per workspace, and absent until the operator edits it --
/// `lib/direct-booking-email-template.ts` holds the default, so a
/// workspace that has never opened the editor still sends a sensible
/// confirmation rather than nothing.
model DirectBookingEmailTemplate {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  /// Off is a real choice: an operator who confirms by text message
  /// does not want a second, colder confirmation going out unsigned.
  isEnabled       Boolean   @default(true)
  subjectTemplate String?
  bodyTemplate    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum BookingRequestKind {
  CANCEL
  RESCHEDULE
}

enum BookingRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A renter asking to cancel or move a booking they made online.
///
/// A request, not an action. Approving is what cancels the trip and
/// moves the money, and that stays with the operator: a date change
/// has to be checked against the rest of the fleet's calendar, and a
/// refund is money leaving the business. What the renter gets is a way
/// to ask without a phone call, and a record that they did.
model BookingChangeRequest {
  id          String               @id @default(cuid())
  workspaceId String?
  orderId     String
  kind        BookingRequestKind
  status      BookingRequestStatus @default(PENDING)

  /// Requested dates, for a RESCHEDULE. Null on a cancellation.
  requestedPickupDate DateTime?
  requestedReturnDate DateTime?

  renterNote   String?
  operatorNote String?

  /// What the policy said was refundable when the renter asked,
  /// captured at request time. The window that decides it keeps
  /// closing, so a figure computed later would answer a different
  /// question than the one the renter was shown.
  quotedRefundAmount Float?
  /// What was actually sent back, once approved.
  refundedAmount     Float?
  stripeRefundId     String?

  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([orderId])
}

/// Fleet-wide booking policy, and the default every vehicle inherits.
///
/// Absent until an operator saves it; `lib/booking-policy.ts` holds
/// the shipped defaults, so a workspace that has never opened the
/// settings still prices and contracts correctly.
model BookingPricingPolicy {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// Off the rent once a booking reaches seven days. Applied to the
  /// whole rental rather than to complete weeks: a renter can be told
  /// "a week or more is 30% off" in one sentence, and "30% off the
  /// first 7 days and full price for the other 3" in none.
  weeklyDiscountPercent   Float @default(30)
  /// Bookings shorter than this are refused. 1 means no restriction.
  minimumRentalDays       Int   @default(1)
  /// Kilometres included per rented day.
  dailyKmAllowance        Int   @default(100)
  /// Charged per kilometre beyond the allowance. Settable because the
  /// allowance is: a contract that reads "100 KM per Day and $0.12/km"
  /// while the fleet actually allows 200 is worse than no clause.
  extraKmRate             Float @default(0.12)
  /// What the suggested daily rate is multiplied by.
  ///
  /// The income model measures what Turo PAID OUT per rented day --
  /// net of their cut -- so it is a floor, not a list price. Turning
  /// one into the other needs a number we have never measured, so it
  /// is a setting with a default rather than a constant in the code.
  /// 1.6 is the median ratio between this operator's own manual
  /// prices and the model's figure across their fleet.
  suggestedRateMultiplier Float @default(1.6)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
