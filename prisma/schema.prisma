generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  available
  maintenance
  inactive
}

enum OwnerAccessType {
  share_link
  account_login
}

enum OrderSource {
  turo
  offline
}

enum OrderStatus {
  booked
  ongoing
  completed
  cancelled
}

enum ShareVisibility {
  standard
  privacy
}

enum WorkspaceBillingStatus {
  inactive
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum OwnerLedgerKind {
  OWNER_NET_EARNING
  MANAGER_COMMISSION
  CLEANING_FEE
  EXPENSE_REIMBURSEMENT
  MANUAL_ADJUSTMENT
  SETTLEMENT_PAYMENT
}

enum OrderAttachmentKind {
  photo
  document
}

enum StaffTaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum StaffTaskPriority {
  low
  normal
  high
}

enum ContractFieldType {
  SIGNATURE
  TEXT
  DATE
  CHECKBOX
  REDACTION
}

enum ContractEnvelopeStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  COMPLETED
  VOIDED
  EXPIRED
}

enum ContractRecipientStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum ContractAuditEvent {
  CREATED
  SENT
  VIEWED
  SIGNED
  COMPLETED
  VOIDED
  PDF_GENERATED
  EMAIL_FAILED
}

// Who keeps a given category of trip income when splitting with a
// vehicle owner. OWNER means it flows through to the owner's statement
// like ordinary rental revenue; MANAGER means the fleet operator keeps
// it and the owner's statement carries an explicit deduction line for
// that amount.
enum LedgerShareTarget {
  OWNER
  MANAGER
}

model Workspace {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  // Owner revenue-split policy. Turo's `Total earnings` bundles several
  // kinds of income together, and who they belong to depends on the
  // operator's arrangement with each vehicle owner:
  //
  //   reimbursementShare — gas, tolls, EV charging, cleaning. Money the
  //     guest paid back for a cost somebody fronted. Belongs to whoever
  //     actually paid it.
  //   serviceShare       — delivery, extras, airport operations fee.
  //     Payment for labour, so it belongs to whoever performed it.
  //   penaltyShare       — late / improper-return / smoking fees and
  //     fines paid to host. These compensate for harm to the vehicle,
  //     so OWNER is the usual answer.
  //
  // All three default to OWNER, which reproduces the behaviour that
  // shipped in v0.24.0 (the full `Total earnings` reaching the owner).
  // Changing a setting only affects statements the next time the
  // affected orders are re-synced.
  reimbursementShare            LedgerShareTarget              @default(OWNER)
  serviceShare                  LedgerShareTarget              @default(OWNER)
  penaltyShare                  LedgerShareTarget              @default(OWNER)
  users                         User[]
  owners                        Owner[]
  vehicles                      Vehicle[]
  orders                        Order[]
  importBatches                 ImportBatch[]
  shareLinks                    ShareLink[]
  activityLogs                  ActivityLog[]
  ownerLedgerItems              OwnerLedgerItem[]
  ownerLedgerReceipts           OwnerLedgerReceipt[]
  orderAttachments              OrderAttachment[]
  staffMembers                  StaffMember[]
  staffTasks                    StaffTask[]
  staffTaskAttachments          StaffTaskAttachment[]
  staffTaskNotificationTemplate StaffTaskNotificationTemplate?
  directBookingDocuments        DirectBookingDocument[]
  contractTemplates             ContractTemplate[]
  contractEnvelopes             ContractEnvelope[]
  contractAuditLogs             ContractAuditLog[]
  contractTextPresets           ContractTextPreset[]
  turoSyncConfig                TuroSyncConfig?
  billing                       WorkspaceBilling?
  inboundEmails                 InboundEmail[]
  assistantThreads              AssistantThread[]
  assistantAlerts               AssistantAlert[]
}

model User {
  id              String     @id @default(cuid())
  workspaceId     String?
  name            String
  email           String     @unique
  passwordHash    String
  isBillingExempt Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Owner {
  workspaceId String?
  id          String            @id @default(cuid())
  name        String
  phone       String?
  email       String?
  companyName String?
  accessType  OwnerAccessType   @default(share_link)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicles    Vehicle[]
  shareLinks  ShareLink[]
  ledgerItems OwnerLedgerItem[]

  @@index([workspaceId])
}

model Vehicle {
  workspaceId            String?
  id                     String                  @id @default(cuid())
  ownerId                String?
  plateNumber            String                  @unique
  nickname               String
  brand                  String
  model                  String
  year                   Int
  vin                    String?
  status                 VehicleStatus           @default(available)
  turoListingName        String?
  turoVehicleCode        String?
  purchasePrice          Float?
  ownerCommissionRate    Float?
  cleaningFee            Float?
  pickupPassword         String?
  directBookingEnabled   Boolean                 @default(false)
  bookingDailyRate       Float?
  bookingInsuranceFee    Float?
  bookingDepositAmount   Float?
  bookingTaxName         String?
  bookingTaxRate         Float?
  bookingIntro           String?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner                  Owner?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orders                 Order[]
  ownerLedgerItems       OwnerLedgerItem[]
  attachments            OrderAttachment[]
  staffTasks             StaffTask[]
  directBookingDocuments DirectBookingDocument[]

  @@index([workspaceId])
  inboundEmails          InboundEmail[]
}

model Order {
  workspaceId            String?
  id                     String                  @id @default(cuid())
  vehicleId              String
  importBatchId          String?
  source                 OrderSource
  externalOrderId        String?
  renterName             String
  renterPhone            String?
  pickupDatetime         DateTime
  returnDatetime         DateTime
  totalPrice             Float?
  depositAmount          Float?
  status                 OrderStatus             @default(booked)
  pickupLocation         String?
  returnLocation         String?
  paymentMethod          String?
  contractNumber         String?
  notes                  String?
  sourceMetadata         String?
  createdBy              String
  isArchived             Boolean                 @default(false)
  hasConflict            Boolean                 @default(false)
  ownerLedgerSyncedAt    DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  importBatch            ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  vehicle                Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  ownerLedgerItems       OwnerLedgerItem[]
  attachments            OrderAttachment[]
  staffTasks             StaffTask[]
  directBookingDocuments DirectBookingDocument[]
  contractEnvelopes      ContractEnvelope[]
  inboundEmails          InboundEmail[]

  @@index([workspaceId])
  @@index([workspaceId, isArchived])
  @@index([vehicleId, pickupDatetime, returnDatetime])
  @@index([source, externalOrderId])
  @@index([ownerLedgerSyncedAt])
}

model ImportBatch {
  workspaceId String?
  id          String     @id @default(cuid())
  fileName    String
  importedBy  String
  importedAt  DateTime   @default(now())
  totalRows   Int
  successRows Int
  failedRows  Int
  notes       String?
  mapping     String?
  failures    String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([workspaceId])
}

model TuroSyncConfig {
  workspaceId           String    @unique
  id                    String    @id @default(cuid())
  csvUrl                String?
  csvYear               Int?
  csvPath               String?
  csvAuthHeader         String?
  csvHeaders            String?
  csvMapping            String?
  createMissingVehicles Boolean   @default(true)
  archiveMissingOrders  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OwnerLedgerItem {
  workspaceId        String?
  id                 String               @id @default(cuid())
  ownerId            String
  vehicleId          String?
  orderId            String?
  kind               OwnerLedgerKind
  amount             Float
  occurredAt         DateTime
  note               String?
  receiptUrl         String?
  receiptPathname    String?
  receiptFilename    String?
  receiptContentType String?
  receipts           OwnerLedgerReceipt[]
  isAuto             Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workspace          Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner              Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  order              Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([ownerId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([orderId])
}

model OwnerLedgerReceipt {
  workspaceId String?
  id          String          @id @default(cuid())
  itemId      String
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  uploadedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  item        OwnerLedgerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([itemId])
}

model OrderAttachment {
  workspaceId String?
  id          String              @id @default(cuid())
  orderId     String?
  vehicleId   String?
  kind        OrderAttachmentKind
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  isArchived  Boolean             @default(false)
  uploadedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([orderId, kind])
  @@index([vehicleId, kind])
  @@index([isArchived])
  @@index([uploadedAt])
}

model DirectBookingDocument {
  workspaceId       String?
  id                String     @id @default(cuid())
  vehicleId         String
  orderId           String?
  checkoutSessionId String?
  draftId           String
  kind              String
  pathname          String
  filename          String?
  contentType       String?
  size              Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  order             Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([vehicleId])
  @@index([orderId])
  @@index([checkoutSessionId])
  @@index([draftId])
}

model StaffMember {
  workspaceId               String?
  id                        String      @id @default(cuid())
  name                      String
  phone                     String?
  email                     String?
  role                      String?
  color                     String      @default("#3456df")
  notes                     String?
  pinnedMessage             String?
  isActive                  Boolean     @default(true)
  sortOrder                 Int         @default(0)
  shareToken                String?
  miniProgramCode           String?     @unique
  wechatOpenId              String?     @unique
  wechatNotificationEnabled Boolean     @default(false)
  wechatSubscribedAt        DateTime?
  wechatBoundAt             DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  workspace                 Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks                     StaffTask[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, isActive, sortOrder])
  @@index([shareToken])
  @@index([miniProgramCode])
  @@index([wechatOpenId])
}

model StaffTask {
  workspaceId  String?
  id           String                @id @default(cuid())
  staffId      String?
  parentTaskId String?
  vehicleId    String?
  orderId      String?
  staffLabel   String?
  vehicleLabel String?
  orderLabel   String?
  title        String
  details      String?
  dueDatetime  DateTime?
  timeWindow   String?
  status       StaffTaskStatus       @default(todo)
  priority     StaffTaskPriority     @default(normal)
  category     String?
  sortOrder    Int                   @default(0)
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  staff        StaffMember?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  parentTask   StaffTask?            @relation("StaffTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     StaffTask[]           @relation("StaffTaskSubtasks")
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attachments  StaffTaskAttachment[]

  @@index([workspaceId, status])
  @@index([parentTaskId, sortOrder])
  @@index([staffId, dueDatetime])
  @@index([vehicleId, dueDatetime])
  @@index([orderId])
}

model StaffTaskAttachment {
  workspaceId String?
  id          String              @id @default(cuid())
  taskId      String
  kind        OrderAttachmentKind @default(photo)
  url         String?
  pathname    String
  filename    String?
  contentType String?
  size        Int?
  isArchived  Boolean             @default(false)
  uploadedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  task        StaffTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId, kind])
  @@index([isArchived])
  @@index([uploadedAt])
}

model StaffTaskNotificationTemplate {
  workspaceId          String    @unique
  id                   String    @id @default(cuid())
  emailSubjectTemplate String?
  emailBodyTemplate    String?
  smsBodyTemplate      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContractTemplate {
  workspaceId       String?
  id                String                      @id @default(cuid())
  name              String
  description       String?
  pdfUrl            String
  pdfPathname       String
  pdfFilename       String?
  pdfContentType    String?
  pdfSize           Int?
  sourceType        String                      @default("PDF")
  sourceUrl         String?
  sourcePathname    String?
  sourceFilename    String?
  sourceContentType String?
  sourceSize        Int?
  editableContent   String?
  pageCount         Int                         @default(1)
  pageSizes         Json?
  active            Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workspace         Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields            ContractTemplateField[]
  recipients        ContractTemplateRecipient[]
  envelopes         ContractEnvelope[]

  @@index([workspaceId, active])
  @@index([createdAt])
}

model ContractTemplateRecipient {
  id           String           @id @default(cuid())
  templateId   String
  name         String
  email        String
  signingOrder Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  template     ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, signingOrder])
}

model ContractTemplateField {
  id             String               @id @default(cuid())
  templateId     String
  type           ContractFieldType
  label          String
  required       Boolean              @default(true)
  recipientIndex Int?
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  placeholder    String?
  defaultValue   String?
  fontSize       Float?
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  template       ContractTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values         ContractFieldValue[]

  @@index([templateId, page, sortOrder])
}

model ContractEnvelope {
  workspaceId          String?
  id                   String                 @id @default(cuid())
  templateId           String
  orderId              String?
  title                String
  message              String?
  status               ContractEnvelopeStatus @default(DRAFT)
  signedPdfUrl         String?
  signedPdfPathname    String?
  signedPdfFilename    String?
  signedPdfContentType String?
  signedPdfSize        Int?
  signedPdfSha256      String?
  sentAt               DateTime?
  completedAt          DateTime?
  voidedAt             DateTime?
  expiresAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workspace            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template             ContractTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  order                Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recipients           ContractRecipient[]
  values               ContractFieldValue[]
  auditLogs            ContractAuditLog[]

  @@index([workspaceId, status])
  @@index([orderId])
  @@index([createdAt])
}

model ContractRecipient {
  id           String                  @id @default(cuid())
  envelopeId   String
  name         String
  email        String
  signingOrder Int                     @default(1)
  token        String                  @unique
  status       ContractRecipientStatus @default(PENDING)
  viewedAt     DateTime?
  signedAt     DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  envelope     ContractEnvelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  values       ContractFieldValue[]
  auditLogs    ContractAuditLog[]

  @@index([envelopeId, signingOrder])
  @@index([email])
}

model ContractFieldValue {
  id          String                @id @default(cuid())
  envelopeId  String
  fieldId     String
  recipientId String?
  value       String?
  signature   String?
  checked     Boolean?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  envelope    ContractEnvelope      @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  field       ContractTemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recipient   ContractRecipient?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([envelopeId, fieldId])
  @@index([recipientId])
}

model ContractAuditLog {
  workspaceId String?
  id          String             @id @default(cuid())
  envelopeId  String
  recipientId String?
  event       ContractAuditEvent
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  envelope    ContractEnvelope   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient   ContractRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([envelopeId, createdAt])
  @@index([workspaceId, createdAt])
}

model ContractTextPreset {
  workspaceId String?
  id          String     @id @default(cuid())
  label       String
  value       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ShareLink {
  workspaceId  String?
  id           String          @id @default(cuid())
  ownerId      String
  token        String          @unique
  passwordHash String?
  expiresAt    DateTime?
  isActive     Boolean         @default(true)
  visibility   ShareVisibility @default(standard)
  createdBy    String
  createdAt    DateTime        @default(now())
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner        Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceBilling {
  id                            String                    @id @default(cuid())
  workspaceId                   String?                   @unique
  freeVehicleSlots              Int                       @default(5)
  bonusVehicleSlots             Int                       @default(0)
  purchasedVehicleSlots         Int                       @default(0)
  stripeCustomerId              String?                   @unique
  stripeSubscriptionId          String?                   @unique
  stripeSubscriptionItemId      String?
  stripePriceId                 String?
  stripePortalConfigurationId   String?
  stripeLatestCheckoutSessionId String?
  status                        WorkspaceBillingStatus    @default(inactive)
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  lastCheckoutAt                DateTime?
  lastPaidAt                    DateTime?
  // Stripe Connect fields — per-workspace payout account for direct-booking
  // revenue. The platform (site owner) collects a flat application fee and the
  // rest is settled on-behalf-of the host's Connect account, so renters see
  // the host's business name on their statement.
  stripeConnectAccountId        String?                   @unique
  stripeConnectCountry          String?
  stripeConnectChargesEnabled   Boolean                   @default(false)
  stripeConnectPayoutsEnabled   Boolean                   @default(false)
  stripeConnectDetailsSubmitted Boolean                   @default(false)
  stripeConnectOnboardedAt      DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  workspace                     Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  couponRedemptions             BillingCouponRedemption[]
}

model BillingCouponRedemption {
  id                 String           @id @default(cuid())
  workspaceBillingId String
  code               String           @unique
  couponType         String
  bonusVehicleSlots  Int              @default(0)
  metadata           String?
  createdAt          DateTime         @default(now())
  workspaceBilling   WorkspaceBilling @relation(fields: [workspaceBillingId], references: [id], onDelete: Cascade)

  @@index([workspaceBillingId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("registration")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model ActivityLog {
  workspaceId String?
  id          String     @id @default(cuid())
  actor       String
  action      String
  entityType  String
  entityId    String
  metadata    String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// Sliding-window rate limit for sensitive auth surfaces (login,
// share-link unlock). One row per (scope, identifier). Old rows are
// best-effort GC'd inside `lib/rate-limit.ts` when checked. The model
// is intentionally generic so the same primitive covers any future
// throttled flow (e.g. password-reset request).
model RateLimitAttempt {
  id            String   @id @default(cuid())
  // Stable bucket name, e.g. "login_email" / "login_ip" / "share_unlock".
  scope         String
  // Bucket key within the scope, e.g. lowercased email, share token,
  // or client IP. Combined with scope it forms a unique row.
  identifier    String
  // Number of failed attempts within the current window. Resets to 0
  // by deleting the row once the window expires.
  attempts      Int      @default(0)
  // Start of the active window. New row → now(); refreshed when a row
  // ages past its window before the next failure is recorded.
  windowStart   DateTime @default(now())
  // Wall clock of the most recent failure, useful for alerting.
  lastAttemptAt DateTime @default(now())

  @@unique([scope, identifier])
  @@index([windowStart])
}

// ---------------------------------------------------------------------
// AI assistant + Turo inbox
// ---------------------------------------------------------------------

// Turo gives hosts no API and no webhooks, but it does email every
// material event: guest messages, booking created / modified /
// cancelled, and support notices. Those land in the operator's Gmail.
// Pulling them in over IMAP is the only near-real-time channel Turo
// leaves open, so this table is TATO's Turo event stream.
enum InboundEmailKind {
  GUEST_MESSAGE
  BOOKING_CREATED
  BOOKING_MODIFIED
  BOOKING_CANCELLED
  TRIP_STARTED
  TRIP_ENDED
  PAYOUT
  SUPPORT
  OTHER
}

model InboundEmail {
  id          String           @id @default(cuid())
  workspaceId String

  // RFC 5322 Message-ID. The dedupe key — an IMAP poll that overlaps a
  // previous run, or a reconnect that replays a range, must not create
  // a second row. Unique per workspace rather than globally so two
  // workspaces watching the same shared mailbox don't collide.
  messageId   String
  fromAddress String
  fromName    String?
  subject     String
  receivedAt  DateTime
  // Plain-text body, truncated at ingest. We deliberately do not store
  // the HTML part or attachments: this table exists to drive alerts and
  // assistant answers, not to be a mail archive.
  bodyText    String

  // Populated by the Kimi extraction pass. `kind` stays OTHER and
  // `parsedAt` stays null when extraction fails, so a failed parse is
  // visible and retryable rather than silently mislabelled.
  kind        InboundEmailKind @default(OTHER)
  parsedAt    DateTime?
  // Extracted fields as JSON: guest name, reservation id, vehicle,
  // dates, amount — whichever the email actually carried.
  parsed      String?
  // Set once the assistant has surfaced this to the operator.
  acknowledgedAt DateTime?

  // Read straight off the subject, which Turo generates from a fixed
  // template. Present long before the model pass runs, so a message is
  // attributable to a guest and a car the moment it lands.
  guestName   String?
  // The vehicle the subject named, when exactly one in the fleet
  // matched. Null when the listing text matched several -- several
  // cars of one model is normal here, and guessing between them would
  // put the message against the wrong car.
  vehicleId   String?

  // The link Turo put in the notification body. Kept as sent rather
  // than constructed from an id, so a routing change on their side
  // does not silently produce dead links on ours.
  turoLink    String?

  // Best-effort link back to the order this email is about: an exact
  // join on the reservation id for booking mail, and a name + vehicle
  // + date-window match for guest messages, which carry no id. Null
  // when the email predates the order's import or when the match was
  // ambiguous -- showing a message against the wrong trip is worse
  // than showing it against none.
  orderId     String?

  createdAt   DateTime         @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, messageId])
  @@index([workspaceId, receivedAt])
  @@index([workspaceId, kind, acknowledgedAt])
  @@index([orderId])
  @@index([vehicleId])
  // The guest-message page groups by guest; this is the index it reads.
  @@index([workspaceId, kind, guestName])
}

model AssistantThread {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AssistantMessage[]

  @@index([workspaceId, userId, updatedAt])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id        String               @id @default(cuid())
  threadId  String
  role      AssistantMessageRole
  content   String
  // Which data the assistant consulted to answer, as JSON. Shown in the
  // UI so the operator can tell an answer grounded in their fleet from
  // one the model invented.
  context   String?
  createdAt DateTime             @default(now())

  thread    AssistantThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum AssistantAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Something the operator should look at. Written by the alert scan, not
// by the model — the model only phrases them. Keeping detection in
// plain code means an alert never fires because of a hallucination, and
// never fails to fire because the model was having an off day.
model AssistantAlert {
  id          String                 @id @default(cuid())
  workspaceId String

  // Stable identity for a given real-world condition, e.g.
  // "conflict:<orderId>" or "gmail_sync_failed". Lets a repeated scan
  // update the existing alert instead of stacking duplicates.
  dedupeKey   String
  severity    AssistantAlertSeverity @default(INFO)
  title       String
  body        String
  // Deep link into the app, e.g. /orders?q=<reservation>.
  href        String?

  resolvedAt      DateTime?
  acknowledgedAt  DateTime?
  notifiedAt      DateTime?

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, resolvedAt, severity])
}
