.message-page {
  background: #f4f4f5;
}

.topbar {
  background: #111111;
  color: #ffffff;
  padding: 28rpx 28rpx 30rpx;
}

.kicker {
  color: #a1a1aa;
  font-size: 22rpx;
  font-weight: 700;
}

.headline {
  margin-top: 4rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 800;
}

.channel-line {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.channel-chip {
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  color: #e4e4e7;
  font-size: 22rpx;
}

.channel-empty {
  color: #a1a1aa;
  font-size: 24rpx;
}

.topbar-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.text-button {
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.quota-banner {
  margin: 20rpx 28rpx 0;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  border-left: 6rpx solid #111111;
  border-radius: 10rpx;
}

.quota-empty {
  border-left-color: #dc2626;
  background: #fef2f2;
}

.quota-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #111111;
}

.quota-hint {
  margin-top: 8rpx;
  color: #71717a;
  font-size: 22rpx;
  line-height: 1.5;
}

.state {
  padding: 60rpx 28rpx;
  text-align: center;
  color: #71717a;
  font-size: 26rpx;
}

.state.error {
  color: #dc2626;
}

.list {
  padding: 20rpx 28rpx 0;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  border-radius: 12rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.card-open {
  border-color: #111111;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.badge {
  padding: 4rpx 12rpx;
  background: #f4f4f5;
  border: 1rpx solid #e4e4e7;
  border-radius: 999rpx;
  color: #52525b;
  font-size: 20rpx;
  font-weight: 700;
}

.badge-high {
  background: #111111;
  border-color: #111111;
  color: #ffffff;
}

.card-time {
  color: #a1a1aa;
  font-size: 22rpx;
}

.card-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #111111;
}

.card-channel {
  margin-top: 6rpx;
  color: #71717a;
  font-size: 24rpx;
}

.card-body {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e4e4e7;
}

.row {
  display: flex;
  gap: 18rpx;
  padding: 8rpx 0;
}

.row-label {
  width: 96rpx;
  flex-shrink: 0;
  color: #71717a;
  font-size: 24rpx;
}

.row-value {
  flex: 1;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.link-button {
  margin-top: 18rpx;
  height: 84rpx;
  background: #111111;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}
