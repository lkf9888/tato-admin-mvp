.tasks-page {
  background: #f4f4f5;
}

.topbar {
  background: #111111;
  color: #ffffff;
  padding: 28rpx 28rpx 30rpx;
}

.staff-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.staff-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.staff-copy {
  flex: 1;
  min-width: 0;
}

.kicker {
  color: #a1a1aa;
  font-size: 22rpx;
  font-weight: 700;
}

.staff-name {
  margin-top: 4rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 800;
}

.staff-role {
  margin-top: 6rpx;
  color: #d4d4d8;
  font-size: 26rpx;
}

.text-button {
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.summary-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.summary-card {
  background: #262626;
  border-radius: 10rpx;
  padding: 20rpx;
}

.summary-label {
  color: #a1a1aa;
  font-size: 24rpx;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.notify-button {
  margin-top: 20rpx;
  height: 76rpx;
  background: #ffffff;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
}

.notify-button.is-on {
  background: #dcfce7;
  color: #047857;
}

.loading,
.empty-card {
  margin: 24rpx;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 10rpx;
  color: #71717a;
  font-size: 28rpx;
}

.section-title {
  padding: 28rpx 28rpx 10rpx;
  color: #3f3f46;
  font-size: 30rpx;
  font-weight: 800;
}

.date-label {
  padding: 14rpx 28rpx 8rpx;
  color: #71717a;
  font-size: 24rpx;
  font-weight: 800;
}

.task-card,
.history-panel {
  margin: 16rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  border-radius: 10rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.task-title {
  color: #111111;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
}

.task-title.small {
  font-size: 28rpx;
}

.task-meta {
  margin-top: 8rpx;
  color: #71717a;
  font-size: 26rpx;
  line-height: 1.35;
}

.task-detail {
  margin-top: 10rpx;
  color: #3f3f46;
  font-size: 26rpx;
  line-height: 1.45;
  white-space: pre-wrap;
}

.photo-strip {
  margin-top: 16rpx;
  white-space: nowrap;
}

.thumb {
  width: 132rpx;
  height: 132rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background: #e4e4e7;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.action-button {
  min-height: 76rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.action-button.neutral {
  background: #fafafa;
  color: #3f3f46;
  border: 1rpx solid #d4d4d8;
}

.action-button.amber {
  background: #fffbeb;
  color: #92400e;
  border: 1rpx solid #fbbf24;
}

.action-button.blue {
  background: #eff6ff;
  color: #1d4ed8;
  border: 1rpx solid #93c5fd;
}

.action-button.green {
  background: #ecfdf5;
  color: #047857;
  border: 1rpx solid #34d399;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.history-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 800;
}

.history-count,
.history-toggle {
  color: #71717a;
  font-size: 24rpx;
}

.history-body {
  margin-top: 18rpx;
  border-top: 1rpx solid #e4e4e7;
  padding-top: 8rpx;
}

.history-task {
  border-bottom: 1rpx solid #f4f4f5;
  padding: 16rpx 0;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 18rpx;
}

.pager-button {
  flex: 1;
  height: 68rpx;
  background: #ffffff;
  border: 1rpx solid #d4d4d8;
  color: #3f3f46;
  font-size: 24rpx;
}

.pager-status {
  min-width: 96rpx;
  text-align: center;
  color: #71717a;
  font-size: 24rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}

.edit-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 18rpx 18rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
}

.icon-button {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  background: #ffffff;
  border: 1rpx solid #d4d4d8;
  color: #111111;
  font-size: 36rpx;
  line-height: 60rpx;
}

.form-label {
  margin: 18rpx 0 8rpx;
  color: #52525b;
  font-size: 24rpx;
  font-weight: 800;
}

.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d4d4d8;
  border-radius: 8rpx;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 18rpx;
}

.picker-value {
  line-height: 80rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 18rpx;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-button,
.save-button {
  height: 84rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.cancel-button {
  background: #ffffff;
  border: 1rpx solid #d4d4d8;
  color: #111111;
}

.save-button {
  background: #111111;
  color: #ffffff;
}
